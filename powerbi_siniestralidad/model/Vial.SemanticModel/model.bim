          }
        ],
        "lineageTag": "30aac088-f69a-432f-842b-9bd7aa99f2c4",
        "measures": [
          {
            "name": "Total siniestros",
            "description": "Eventos canónicos en el contexto de fecha, localidad y severidad.",
            "expression": "DISTINCTCOUNT(Siniestros[ClaveFuente])",
            "formatString": "#,0",
            "lineageTag": "84aa271d-f73a-4cf0-9c07-fde84a749487"
          },
          {
            "name": "Personas registradas",
            "description": "Registros de actor deduplicados exactamente dentro de la edición elegida.",
            "expression": "COUNTROWS(Actores)",
            "formatString": "#,0",
            "lineageTag": "b5f272ca-8551-412a-8e62-253490b37d41"
          },
          {
            "name": "Lesionados",
            "description": "Personas registradas con lesión según el criterio de gravedad disponible.",
            "expression": "CALCULATE([Personas registradas], KEEPFILTERS(Actores[Resultado] = \"LESIONADO\"))",
            "formatString": "#,0",
            "lineageTag": "70b8ee76-cccb-4831-98e3-b81b15706c40"
          },
          {
            "name": "Fallecidos",
            "description": "Personas registradas fallecidas según el criterio de gravedad disponible.",
            "expression": "CALCULATE([Personas registradas], KEEPFILTERS(Actores[Resultado] = \"FALLECIDO\"))",
            "formatString": "#,0",
            "lineageTag": "502eadfa-b5d2-4b67-ab3b-3cab986cb55c"
          },
          {
            "name": "Vehículos registrados",
            "description": "Filas vehiculares de la edición elegida, incluidas las que carecen de código de vehículo.",
            "expression": "COUNTROWS(Vehiculos)",
            "formatString": "#,0",
            "lineageTag": "5ac709bc-0db9-4e5f-8b6c-eee905dca027"
          },
          {
            "name": "Siniestros por actor",
            "description": "Eventos con al menos un registro del actor seleccionado.",
            "expression": "DISTINCTCOUNT(Actores[ClaveFuente])",
            "formatString": "#,0",
            "lineageTag": "90b159c3-48b6-41b8-93fd-1ab29b586ecb"
          },
          {
            "name": "Siniestros por vehículo",
            "description": "Eventos con al menos un vehículo del tipo seleccionado.",
            "expression": "DISTINCTCOUNT(Vehiculos[ClaveFuente])",
            "formatString": "#,0",
            "lineageTag": "9972b71c-ea6a-41af-91b0-6b7626c833ab"
          },
          {
            "name": "Vehículos por siniestro",
            "description": "Promedio de vehículos del contexto por evento que tiene esos vehículos.",
            "expression": "DIVIDE([Vehículos registrados], [Siniestros por vehículo])",
            "formatString": "0.00",
            "lineageTag": "dc165cfb-7ba9-4df4-83e7-7872dda58288"
          },
          {
            "name": "Participación actores",
            "description": "Cuota sobre los tipos de actor visibles en la selección.",
            "expression": "DIVIDE([Personas registradas], CALCULATE([Personas registradas], ALLSELECTED(TiposActor[condicion])))",
            "formatString": "0.0%",
            "lineageTag": "66215c66-429f-426c-b7f5-e83d99ee7abd"
          },
          {
            "name": "Participación vehículos",
            "description": "Cuota sobre los tipos de vehículo visibles en la selección.",
            "expression": "DIVIDE([Vehículos registrados], CALCULATE([Vehículos registrados], ALLSELECTED(TiposVehiculo[clase_vehiculo_nombre])))",
            "formatString": "0.0%",
            "lineageTag": "ea37243f-5f8f-4da4-ba7b-a0aa46257402"
          },
          {
            "name": "Siniestros fatales",
            "description": "Eventos clasificados con muertos en la fuente de siniestros.",
            "expression": "CALCULATE([Total siniestros], KEEPFILTERS(Siniestros[Severidad] = \"CON MUERTOS\"))",
            "formatString": "#,0",
            "lineageTag": "025dffbb-165d-43ad-93eb-9e9b42b3cd4e"
          },
          {
            "name": "Porcentaje fatal",
            "description": "Proporción fatal entre los eventos con severidad informada.",
            "expression": "DIVIDE([Siniestros fatales], CALCULATE([Total siniestros], KEEPFILTERS(Siniestros[Severidad] <> \"SIN INFORMACION\")))",
            "formatString": "0.0%",
            "lineageTag": "edd5b90e-ca04-4bd7-a674-09dc08edd35d"
          },
          {
            "name": "Georreferenciados",
            "description": "Eventos con un par latitud y longitud dentro del rango de control.",
            "expression": "CALCULATE([Total siniestros], KEEPFILTERS(Siniestros[Georreferenciado] = TRUE()))",
            "formatString": "#,0",
            "lineageTag": "3b6a2e5c-c4a1-47f1-89c1-72aa8889ce68"
          },
          {
            "name": "Cobertura geográfica",
            "description": "Proporción de eventos con coordenadas dentro del rango de control.",
            "expression": "DIVIDE([Georreferenciados], [Total siniestros])",
            "formatString": "0.0%",
            "lineageTag": "589fc99e-b973-4e23-927c-02ccc366b94e"
          },
          {
            "name": "Siniestros actor y vehículo",
            "description": "Eventos donde coexisten el actor y el tipo de vehículo seleccionados.",
            "expression": "CALCULATE([Total siniestros], KEEPFILTERS(TREATAS(VALUES(Actores[ClaveFuente]), Siniestros[ClaveFuente])), KEEPFILTERS(TREATAS(VALUES(Vehiculos[ClaveFuente]), Siniestros[ClaveFuente])))",
            "formatString": "#,0",
            "lineageTag": "2fc53038-6824-4ed4-b7c5-bdfd4e68b76a"
          },
          {
            "name": "Siniestros con velocidad",
            "description": "Eventos con bandera de velocidad verdadera.",
            "expression": "CALCULATE([Total siniestros], KEEPFILTERS(Siniestros[con_velocidad] = TRUE()))",
            "formatString": "#,0",
            "lineageTag": "3cbae5df-6770-474c-ae75-a7615e1e74c3"
          },
          {
            "name": "Siniestros con embriaguez",
            "description": "Eventos con bandera de embriaguez verdadera.",
            "expression": "CALCULATE([Total siniestros], KEEPFILTERS(Siniestros[con_embriaguez] = TRUE()))",
            "formatString": "#,0",
            "lineageTag": "220d93c5-d966-4fd0-938a-a09248479add"
          },
          {
            "name": "Mes anterior",
            "description": "Eventos en las fechas visibles desplazadas un período.",
            "expression": "CALCULATE([Total siniestros], DATEADD(Calendario[Fecha], -1, MONTH))",
            "formatString": "#,0",
            "lineageTag": "8da790c7-b1fd-4707-9720-a31d1bc94e88"
          },
          {
            "name": "Variación mensual",
            "description": "Cambio relativo frente al período mensual anterior.",
            "expression": "IF([Mes anterior] > 0, DIVIDE([Total siniestros] - [Mes anterior], [Mes anterior]))",
            "formatString": "0.0%",
            "lineageTag": "1cecda1e-b44b-4ab6-9d67-d0efd8c3bb15"
          },
          {
            "name": "Año anterior",
            "description": "Eventos en las fechas visibles desplazadas un período.",
            "expression": "CALCULATE([Total siniestros], DATEADD(Calendario[Fecha], -1, YEAR))",
            "formatString": "#,0",
            "lineageTag": "7ddde1db-c5fa-4012-aa4a-c9721ac460cf"
          },
          {
            "name": "Variación anual",
            "description": "Cambio relativo frente al período anual anterior.",
            "expression": "IF([Año anterior] > 0, DIVIDE([Total siniestros] - [Año anterior], [Año anterior]))",
            "formatString": "0.0%",
            "lineageTag": "f5b4dd29-d457-465a-ac63-8074b4e0a791"
          }
        ],
        "partitions": [
          {
            "name": "Siniestros",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Raw = LeerParquet(\"siniestros\"),",
                "    Tipos = Table.TransformColumnTypes(Raw, {{\"fecha\", type date}, {\"source_year\", Int64.Type}, {\"codigo_siniestro\", Int64.Type}, {\"hora\", Int64.Type}, {\"latitud\", type number}, {\"longitud\", type number}}),",
                "    Fuentes = Table.AddColumn(Tipos, \"ClaveFuente\", each ClaveFuente(_), type text),",
                "    Control = if List.Contains(Fuentes[fecha], null) or Table.RowCount(Fuentes) <> List.Count(List.Distinct(Fuentes[ClaveFuente])) then error \"Fecha ausente o clave de fuente duplicada\" else Fuentes,",
                "    Eventos = Table.AddColumn(Control, \"AnioEvento\", each Date.Year([fecha]), Int64.Type),",
                "    Ediciones = Table.Group(Eventos, {\"AnioEvento\", \"codigo_siniestro\"}, {{\"Edicion\", each List.Max([source_year]), Int64.Type}, {\"Formularios\", each List.Distinct([formulario]), type list}, {\"N\", each Table.RowCount(_), Int64.Type}}),",
                "    Validas = Table.SelectRows(Ediciones, each if [N] > 1 and (List.Count([Formularios]) <> 1 or List.Contains([Formularios], null)) then error \"Ediciones con formularios incompatibles\" else true),",
                "    Canonicos = Table.RemoveColumns(Table.NestedJoin(Eventos, {\"AnioEvento\", \"codigo_siniestro\", \"source_year\"}, Validas, {\"AnioEvento\", \"codigo_siniestro\", \"Edicion\"}, \"Edicion\", JoinKind.Inner), {\"Edicion\"}),",
                "    Localidad = Table.TransformColumns(Canonicos, {{\"localidad\", Categoria, type text}, {\"clase_nombre\", Categoria, type text}}),",
                "    Gravedad = Table.AddColumn(Localidad, \"Severidad\", each Categoria([gravedad_30d_nombre] ?? [gravedad_tradicional_nombre]), type text),",
                "    Geo = Table.AddColumn(Gravedad, \"Georreferenciado\", each [latitud] <> null and [longitud] <> null and [latitud] >= 4 and [latitud] <= 5 and [longitud] >= -75 and [longitud] <= -73, type logical),",
                "    Resultado = Table.SelectColumns(Geo, {\"ClaveFuente\",\"codigo_siniestro\",\"source_year\",\"fecha\",\"hora\",\"localidad\",\"clase_nombre\",\"Severidad\",\"latitud\",\"longitud\",\"Georreferenciado\",\"con_embriaguez\",\"con_velocidad\",\"con_huecos\",\"con_moto\",\"con_peaton\",\"con_bicicleta\"})",
                "in",
                "    Resultado"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "Actores",
        "columns": [
          {
            "name": "ClaveFuente",
            "dataType": "string",
            "isHidden": true,
            "lineageTag": "f11d9c1e-92b1-4321-8c6a-e6b92a07fe11",
            "sourceColumn": "ClaveFuente",
            "summarizeBy": "none"
          },
          {
            "name": "condicion",
            "dataType": "string",
            "lineageTag": "4f4240c6-84cf-4da2-b3b0-42af2aca89d4",
            "sourceColumn": "condicion",
            "summarizeBy": "none"
          },
          {
            "name": "condicion_especifica",
            "dataType": "string",
            "lineageTag": "7d25cad8-7443-4604-92b2-47a048e48398",
            "sourceColumn": "condicion_especifica",
            "summarizeBy": "none"
          },
          {
            "name": "sexo",
            "dataType": "string",
            "lineageTag": "d96a0ae2-f6a5-40a0-8141-a7cc781761a2",
            "sourceColumn": "sexo",
            "summarizeBy": "none"
          },
          {
            "name": "edad",
            "dataType": "int64",
            "lineageTag": "1450dd35-fc15-473c-bc64-798dcafa73e0",
            "sourceColumn": "edad",
            "summarizeBy": "none"
          },
          {
            "name": "Resultado",
            "dataType": "string",
            "lineageTag": "3f88d3af-3732-4c7e-ab37-d8d6880d5f12",
            "sourceColumn": "Resultado",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "f81db0c7-3c76-4180-bc95-a969ed2ef292",
        "partitions": [
          {
            "name": "Actores",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Base = DetalleCanonico(\"actor_vial\", true),",
                "    Categorias = Table.TransformColumns(Base, {{\"condicion\", Categoria, type text}, {\"condicion_especifica\", Categoria, type text}, {\"sexo\", Categoria, type text}}),",
                "    Gravedad = Table.AddColumn(Categorias, \"Resultado\", each let g = Categoria([gravedad_30d] ?? [gravedad_tradicional]) in",
                "        if List.Contains({\"HERIDO\",\"HERIDO HOSPITALIZADO\",\"HERIDO VALORADO\"}, g) then \"LESIONADO\"",
                "        else if List.Contains({\"MUERTO\",\"MUERTA\"}, g) then \"FALLECIDO\"",
                "        else g, type text),",
                "    Edad = Table.TransformColumns(Gravedad, {{\"edad\", each if _ <> null and _ >= 0 and _ <= 120 then _ else null, Int64.Type}})",
                "in",
                "    Table.SelectColumns(Edad, {\"ClaveFuente\",\"condicion\",\"condicion_especifica\",\"sexo\",\"edad\",\"Resultado\"})"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "Vehiculos",
        "columns": [
          {
            "name": "ClaveFuente",
            "dataType": "string",
            "isHidden": true,
            "lineageTag": "df7192e7-d6ba-4479-991f-a7cbf91bd155",
