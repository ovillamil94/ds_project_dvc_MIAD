        "toColumn": "localidad",
        "toTable": "Localidades"
      },
      {
        "name": "Actores_ClaveFuente_Siniestros",
        "fromColumn": "ClaveFuente",
        "fromTable": "Actores",
        "toColumn": "ClaveFuente",
        "toTable": "Siniestros"
      },
      {
        "name": "Vehiculos_ClaveFuente_Siniestros",
        "fromColumn": "ClaveFuente",
        "fromTable": "Vehiculos",
        "toColumn": "ClaveFuente",
        "toTable": "Siniestros"
      },
      {
        "name": "Actores_condicion_TiposActor",
        "fromColumn": "condicion",
        "fromTable": "Actores",
        "toColumn": "condicion",
        "toTable": "TiposActor"
      },
      {
        "name": "Vehiculos_clase_vehiculo_nombre_TiposVehiculo",
        "fromColumn": "clase_vehiculo_nombre",
        "fromTable": "Vehiculos",
        "toColumn": "clase_vehiculo_nombre",
        "toTable": "TiposVehiculo"
      }
    ],
    "sourceQueryCulture": "es-CO",
    "tables": [
