{
  "compatibilityLevel": 1600,
  "model": {
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Siniestros\",\"Actores\",\"Vehiculos\",\"Calendario\",\"Localidades\",\"TiposActor\",\"TiposVehiculo\",\"RutaDatos\",\"OrigenParquet\",\"LeerParquet\",\"ClaveFuente\",\"Categoria\",\"DetalleCanonico\",\"Diccionario\"]"
      },
      {
        "name": "PBI_ProTooling",
        "value": "[\"DevMode\"]"
      }
    ],
    "culture": "es-CO",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "expressions": [
      {
        "name": "RutaDatos",
        "expression": "\"C:/ruta/ds_project_dvc_MIAD/data/processed\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "kind": "m",
        "lineageTag": "6ca00dc1-4d01-4412-bece-a69cb9596e73"
      },
      {
        "name": "OrigenParquet",
        "expression": "Folder.Contents(RutaDatos)",
        "kind": "m",
        "lineageTag": "4fe0d4fb-8392-4e5b-9eb1-2d150cc1c754"
      },
      {
        "name": "LeerParquet",
        "expression": [
          "(nombre as text) as table =>",
          "let",
          "    Archivo = nombre & \".parquet\",",
          "    Contenido = OrigenParquet{[Name = Archivo]}[Content]",
          "in",
          "    Parquet.Document(Contenido)"
        ],
        "kind": "m",
        "lineageTag": "a75aec12-e426-42ec-aa82-4aab1df3b367"
      },
      {
        "name": "ClaveFuente",
        "expression": [
          "(fila as record) as text =>",
          "Text.From(fila[source_year], \"en-US\") & \"|\" & Text.From(fila[codigo_siniestro], \"en-US\")"
        ],
        "kind": "m",
        "lineageTag": "7dcb0448-ba80-4fa2-917f-146a1f2a31ac"
      },
      {
        "name": "Categoria",
        "expression": [
          "(valor as nullable text) as text =>",
          "if valor = null or Text.Trim(valor) = \"\" then \"SIN INFORMACION\" else Text.Upper(Text.Trim(Text.Clean(valor)), \"es-CO\")"
        ],
        "kind": "m",
        "lineageTag": "0bd14a2e-18f3-4c87-8d95-203457b27afe"
      },
      {
        "name": "DetalleCanonico",
        "expression": [
          "(nombre as text, eliminarDuplicados as logical) as table =>",
          "let",
          "    Raw = LeerParquet(nombre),",
          "    Filas = if eliminarDuplicados then Table.Distinct(Raw) else Raw,",
          "    Claves = Table.AddColumn(Filas, \"ClaveFuente\", each ClaveFuente(_), type text),",
          "    Seleccion = Table.NestedJoin(Claves, {\"ClaveFuente\"}, Table.SelectColumns(Siniestros, {\"ClaveFuente\"}), {\"ClaveFuente\"}, \"Padre\", JoinKind.Inner)",
          "in",
          "    Table.RemoveColumns(Seleccion, {\"Padre\"})"
        ],
        "kind": "m",
        "lineageTag": "637a5b89-b825-4d07-b30e-e6615ada97fb"
      },
      {
        "name": "Diccionario",
        "expression": "Table.RenameColumns(LeerParquet(\"diccionario\"), {{\"SINIESTROS\",\"Entidad\"},{\"GRAVEDAD\",\"Dominio\"},{\"1\",\"Código\"},{\"Con Muertos\",\"Etiqueta\"}})",
        "kind": "m",
        "lineageTag": "c8622921-ffcc-4739-b36f-674976bec2f1"
      }
    ],
    "relationships": [
      {
        "name": "Siniestros_fecha_Calendario",
        "fromColumn": "fecha",
        "fromTable": "Siniestros",
        "toColumn": "Fecha",
        "toTable": "Calendario"
      },
      {
        "name": "Siniestros_localidad_Localidades",
        "fromColumn": "localidad",
